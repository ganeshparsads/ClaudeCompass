{
  "mcpServers": {
    "claude-compass-obsidian": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-obsidian"
      ],
      "env": {
        "OBSIDIAN_API_KEY": "${OBSIDIAN_API_KEY}",
        "OBSIDIAN_HOST": "127.0.0.1",
        "OBSIDIAN_PORT": "27123"
      }
    },
    "claude-compass-graphify": {
      "command": "graphify",
      "args": [
        "mcp"
      ]
    }
  }
}

