{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/claude-compass/statusline.sh"
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(npm test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npx ccusage:*)",
      "Bash(graphify:*)",
      "Bash(codegraph:*)",
      "Bash(headroom:*)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(sudo rm:*)"
    ]
  }
}

